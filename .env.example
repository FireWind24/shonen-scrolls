# Copy this file to .env and fill in real values. NEVER commit .env.
# In production these go in Vercel: Project -> Settings -> Environment Variables.

# Required — from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxx

# Required — the seller's inbox. NOTE: with the free sender
# (onboarding@resend.dev) this must be the email you signed up to Resend with.
SELLER_EMAIL=seller@gmail.com

# Optional — verified sender. Only set once you add & verify a domain in Resend,
# e.g. RESEND_FROM=orders@yourdomain.com
#RESEND_FROM=onboarding@resend.dev

# Optional — origin used to fetch poster images. Vercel sets this automatically.
#SITE_URL=https://your-site.vercel.app
